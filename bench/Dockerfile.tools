# The generation image: one isolated virtual environment per mutation tool, pinned to the benchmarked release.
# Build from the repository root (the balamut wheel is built from the checked-out commit):
#   uv build --wheel -o bench/.wheels && docker build -f bench/Dockerfile.tools -t pymutbench-tools:1 bench
FROM pymutbench-base:1
COPY .wheels /wheels
RUN set -e; \
    for spec in "mutmut mutmut==3.8.1" "cosmic-ray cosmic-ray==8.7.0" "poodle poodle==1.4.0" \
                "gremlins pytest-gremlins==1.13.2" "leela pytest-leela==0.9.0" "mutation mutation==0.6.0" \
                "universalmutator universalmutator==1.14.1" "fest fest-mutate==0.1.3 pytest-cov" \
                "irradiate irradiate==0.4.3" "deployproof deployproof==1.1.19" \
                "mutatest mutatest==3.1.0 setuptools" "mutpy mutpy==0.6.1"; do \
        set -- $spec; name=$1; shift; \
        uv venv -q /tools/$name; \
        uv pip install -q --python /tools/$name/bin/python "$@" pytest; \
        uv pip freeze --python /tools/$name/bin/python > /tools/$name/freeze.txt; \
    done; \
    uv venv -q /tools/balamut; \
    uv pip install -q --python /tools/balamut/bin/python /wheels/balamut-*.whl; \
    uv pip freeze --python /tools/balamut/bin/python > /tools/balamut/freeze.txt
